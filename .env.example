# Copy to .env for local (non-Docker) runs. Inside docker-compose these
# are set per-service in docker-compose.yml.
KAFKA_BROKER=localhost:19092
KAFKA_TOPIC=wikipedia.edits
DUCKDB_PATH=data/duckdb/wikipedia.duckdb
PARQUET_PATH=data/parquet
CHECKPOINT_PATH=data/checkpoints
WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
USER_AGENT=wikipedia-edit-ingest/1.0 (portfolio project)
REFRESH_SECONDS=15
